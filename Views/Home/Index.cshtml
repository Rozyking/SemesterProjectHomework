
@model DaggerheartCharacter

@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center">
    <h1 class="display-4 mb-4">Welcome</h1>
    <h2 class="mb-3">Daggerheart Party Character Spotlight</h2>

    @if (Model != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8 text-start">
                <partial name="_CharacterCard" model="Model" />
            </div>
        </div>
    }
    
</div>
@section Scripts {
    <script src="https://jgrissom.github.io/dotnet-web-dev/week-06/homework-checks.js"></script>
}