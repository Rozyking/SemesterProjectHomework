@model DaggerheartCharacter

@{
    ViewData["Title"] = "Daggerheart party management tool";
}

<div class="text-center">
    <h1 class="display-4 mb-4">Welcome</h1>
    <p class="lead">
        The perfect tool for keeping track of your party in Daggerheart and all
        of their traits.
    </p>
    <a asp-controller="Daggerheart" asp-action="Index" class="btn btn-primary btn-lg p-4 mb-5">Create or add to your party</a>
    
    <h2 class="mb-3">Daggerheart Party Character Spotlight</h2>

    

    @if (Model != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8 text-start">
                <partial name="_CharacterCard" model="Model" />
            </div>
        </div>
    } else
    {
        <p class="text-muted">
            Your party is empty. <a asp-controller="Daggerheart" asp-action="Create">Add your first character</a>
            and they'll be spotlighted here.
        </p>
    }
    
</div>
@section Scripts {
    <script src="https://jgrissom.github.io/dotnet-web-dev/week-10/homework-checks.js"></script>
}