@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="display-5">Something went wrong</h1>
    <p class="lead text-muted">A wizard cast dark magic on this page! Please return to 
        the party page.
    </p>
    <a asp-controller="Daggerheart" asp-action="Index" class="btn btn-primary">Return to party</a>
</div>
