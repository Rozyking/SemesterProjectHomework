
@model DaggerheartCharacter

<div class="card character-card h-100 mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <h6 class="card-subtitle mb-2 text-muted">@Model.Class</h6>
        <p class="card-text">Hit Points: @Model.HitPoints · Evasion: @Model.Evasion</p>
    </div>
    <div class="card-footer">
        <a href="/Daggerheart/Details/@Model.Id">Details</a>
    </div>
</div>