@model DaggerheartCharacter
@{
    ViewData["Title"] = "Edit a Character";
}

<h1>Edit a character</h1>
<p class="text-muted">Edit an existing member of your Daggerheart Party!</p>

<form asp-action="Edit" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Class" class="form-label"></label>
        <input asp-for="Class" class="form-control" />
        <span asp-validation-for="Class" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="HitPoints" class="form-label"></label>
        <input asp-for="HitPoints" class="form-control" />
        <span asp-validation-for="HitPoints" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Evasion" class="form-label"></label>
        <input asp-for="Evasion" class="form-control" />
        <span asp-validation-for="Evasion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LowerDamageThreshold" class="form-label"></label>
        <input asp-for="LowerDamageThreshold" class="form-control" />
        <span asp-validation-for="LowerDamageThreshold" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="UpperDamageThreshold" class="form-label"></label>
        <input asp-for="UpperDamageThreshold" class="form-control" />
        <span asp-validation-for="UpperDamageThreshold" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save character</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}