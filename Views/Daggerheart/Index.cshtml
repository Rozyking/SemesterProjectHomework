@model List<DaggerheartCharacter>

@{
    ViewData["Title"] = "Party List";
}

<p>@Model.Count @(Model.Count == 1 ? "character" : "characters") in party.</p>

<a asp-action="Create" class="btn btn-primary mb-3">+ Add a character</a>

@if (!Model.Any())
{
    <p class="text-muted">No characters yet. <a asp-action="Create">Add the first one</a>.</p>
}
else
{
    <div class="row">
        @foreach (var character in Model)
        {
            <div class="col-12 col-md-6 col-lg-4 mb-3">
                <partial name="_CharacterCard" model="character" />
            </div>
        }
    </div>
}