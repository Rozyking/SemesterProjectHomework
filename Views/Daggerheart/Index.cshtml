@model List<DaggerheartCharacter>

@{
    ViewData["Title"] = "Party List";
}

<p>@Model.Count characters in party.</p>

<a asp-action="Create" class="btn btn-primary mb-3">+ Add a character</a>

<table>
    <div class="row">
        
        @foreach (var character in Model)
        {
            <div class="col-lg-4 mb-3">
            
                <partial name="_CharacterCard" model="character" />
            
            </div>
        }
        
    </div>
</table>